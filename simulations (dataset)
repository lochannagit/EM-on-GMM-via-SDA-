#a function just for plots
plot_histogram_representation <- function(hist_data,
                                          main_title) {
  
  widths <- hist_data$Upper - hist_data$Lower
  density_values <- hist_data$Count /
    sum(hist_data$Count) /
    widths
  
  plot(
    NA,
    xlim = range(c(hist_data$Lower, hist_data$Upper)),
    ylim = c(0, max(density_values) * 1.15),
    main = main_title,
    xlab = "X",
    ylab = "Density"
  )
  
  rect(
    hist_data$Lower,
    0,
    hist_data$Upper,
    density_values
  )
}

