#7 DATASET A: Varying Sample Size
sample_sizes <- c(
  10^2,
  10^3,
  10^4,
  10^5,
  10^6,
  10^7
)

B <- 10

#a Function to generate GMM data
generate_gmm <- function(N,
                         lambda = c(0.5, 0.5),
                         mu = c(50, 55),
                         sigma = c(1, 2)) {
  
  K <- length(lambda)
  
  z <- sample(
    1:K,
    size = N,
    replace = TRUE,
    prob = lambda
  )
  
  X <- rnorm(
    N,
    mean = mu[z],
    sd = sigma[z]
  )
  
  return(X)
}

#b Function to construct fixed and variable histograms

construct_histograms <- function(X, B = 10) {
  
  # Fixed-width boundaries
  fixed_breaks <- seq(
    min(X),
    max(X),
    length.out = B + 1
  )
  
  fixed_hist <- hist(
    X,
    breaks = fixed_breaks,
    plot = FALSE,
    include.lowest = TRUE
  )
  
  fixed_histogram <- data.frame(
    Bin = 1:B,
    Lower = fixed_hist$breaks[-length(fixed_hist$breaks)],
    Upper = fixed_hist$breaks[-1],
    Count = fixed_hist$counts
  )
  
  
  # Variable-width boundaries using empirical quantiles
  variable_breaks <- quantile(
    X,
    probs = seq(0, 1, length.out = B + 1),
    names = FALSE
  )
  
  variable_hist <- hist(
    X,
    breaks = variable_breaks,
    plot = FALSE,
    include.lowest = TRUE
  )
  
  variable_histogram <- data.frame(
    Bin = 1:B,
    Lower = variable_hist$breaks[-length(variable_hist$breaks)],
    Upper = variable_hist$breaks[-1],
    Count = variable_hist$counts
  )
  
  return(list(
    fixed = fixed_histogram,
    variable = variable_histogram
  ))
}

#c Generate dataset A

dataset_A <- list()

for (N_current in sample_sizes) {
  
  cat("Generating N =", N_current, "\n")
  
  X_current <- generate_gmm(N_current)
  
  histograms <- construct_histograms(
    X_current,
    B = B
  )
  
  dataset_A[[paste0("N_", N_current)]] <- list(
    N = N_current,
    K = 2,
    lambda_true = c(0.5, 0.5),
    mu_true = c(50, 55),
    sigma_true = c(1, 2),
    fixed_histogram = histograms$fixed,
    variable_histogram = histograms$variable
  )
  
  rm(X_current)
  
  gc()
}

