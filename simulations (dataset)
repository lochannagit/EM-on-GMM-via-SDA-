#b generate
for (K_current in K_values) {
  
  cat("Generating K =", K_current, "\n")
  
  lambda_C <- rep(1 / K_current, K_current)
  mu_C <- 45 + 5 * (1:K_current)
  sigma_C <- 1:K_current
  
  X_C <- generate_gmm(
    N = N_C,
    lambda = lambda_C,
    mu = mu_C,
    sigma = sigma_C
  )
  
  for (B_current in B_values) {
    
    cat("   B =", B_current, "\n")
    
    histograms <- construct_histograms(
      X_C,
      B = B_current
    )
    
    dataset_C[[paste0(
      "K_", K_current, "_B_", B_current
    )]] <- list(
      N = N_C,
      K = K_current,
      B = B_current,
      lambda_true = lambda_C,
      mu_true = mu_C,
      sigma_true = sigma_C,
      fixed_histogram = histograms$fixed,
      variable_histogram = histograms$variable
    )
  }
  
  rm(X_C)
  gc()
}

